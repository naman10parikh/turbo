# wikimem
.wikimem-cache/
node_modules/

# WikiMem test vault personal data
my-wiki/raw/
tools/agentgrid/app/release/

packages/web/.next/
*.pack

# macOS metadata
**/.DS_Store

# Ephemeral harness state (never commit)
.claude/worktrees/
.claude/backups/
.claude/scheduled_tasks.lock
.claude/vp-signals/*.done
.claude/vp-signals/*.needs-qa
.claude/vp-signals/*.migrating

# Obsidian temp files
vault/Untitled*.base

.env
.env.*
.claude/x-intel/

# turbo build artifacts + runtime telemetry (regenerated by `pnpm build`/`prepare`; the run-logger appends here)
dist/
logs/*.jsonl

# Generated service trees — the acceptance CI (E23) writes ./.accept; never source, regenerated by `turbo api`
.accept/
/turbo-service/

# RSI engine (D17) gated proposal artifacts — runtime output of workflows/rsi.workflow.js, never source
.rsi/
